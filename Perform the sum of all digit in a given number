// WAP to perform the sum of all digit in a given number
#include<stdio.h>
int main(){
    int num ,sum=0,digit;
    printf("enter the number  :");
    scanf("%d",&num);
    while (num!=0){
        digit = num%10;
        sum+= digit;
        num=num/10;
    }
    printf("sum of the digit : %d\n",sum);
    return 0 ;
}
