// WAP to find maximum of n numbers 
#include<stdio.h>
int main(){
    int i,num,max=0,n ;
    printf("enter the value of n : ");
    scanf("%d",&n);
    for (i=1;i<=n; i++){
        printf("ENTER THE NUMBER :");
        scanf("%d",&num);
        if(num>max)
            max=num ;
    }
    printf("MAXIMUM NUMBER ID %d",max);
    return 0 ;
}
