// WAP to print n numbers of fibonacci series 
#include<stdio.h>
int main(){
    int n , first = 1, second = 2,next,i;
    printf("ENTER THE NUMBER OF TERMS : ");
    scanf("%d",&n);
    for (i=3;i<=n;i++){
        next=first+second;
        printf("%d",next);
        first=second;
        second=next;
    }
    printf("\n");
    return 0 ;
}
