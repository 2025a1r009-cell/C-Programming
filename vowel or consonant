// program to check given character is vowel or consonant.
#include <stdio.h>
int main(){
    char ch;
    printf("ENTER CHARACTER : ");
    scanf("%c", &ch);
    if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' || ch == 'A' || ch == 'I' || ch == "E" || ch == 'O' ||
        ch == 'U')
        printf("%c is vowel \n");
    else
        printf("%c is consonant\n");

    return 0;
}
